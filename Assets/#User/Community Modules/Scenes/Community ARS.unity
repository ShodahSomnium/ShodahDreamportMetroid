      m_Calls: []
  m_text: "<color=#FFFF22><size=22><b>[ ARS Shader Global Texture ]</b></size></color>\n\r\u2022
    The texture size is 64x64 pixels.\n\n<color=#40A0FF><b>Spectrogram (R Channel):</b>\r</color>\n\u2022
    <indent=10>The texture \"U\" axis (or X axis) represent frequencies from 0 to
    16khz.</indent>\r\n\u2022 <indent=10>The texture \"V\" axis (or Y axis) represent
    time (arround 1 second total).</indent>\r\n\n<color=#40A0FF><b>Smoothgram (G
    Channel):</b>\r</color>\n\u2022 <indent=10>The texture \"U\" axis (or X axis)
    represent frequencies from 0 to 16khz.</indent>\r\n\u2022 <indent=10>The texture
    \"V\" axis (or Y axis) represent frequency smoothing. The deeper is the V axis
    the smoother is the variation.</indent>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
