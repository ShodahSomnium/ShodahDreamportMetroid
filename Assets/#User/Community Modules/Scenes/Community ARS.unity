  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#FFFF22><size=22><b>[ How Does It Work? ]</b></size></color>\r\n<color=#40A0FF><b>ARS
    Shaders:</b>\r</color>\n\u2022 <indent=10>All shaders use a global texture updated
    by ARS.</indent>\r\n\u2022 <indent=10>This texture contains information about
    the audio frequencies.</indent>\r\n\u2022 <indent=10>You can use the example
    shaders provided, or create your own. Just treat it like a normal texture.</indent>\r\n\r\n<color=#40A0FF><b>ARS
    Channels:</b>\r\r</color>\n\u2022 <indent=10>Generates four spectrum channels.
    Each channel is a single value calculated from a range of frequencies. Use these
    values to control scripts that affect objects\u2019 color, shape, sound, and
    more.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
