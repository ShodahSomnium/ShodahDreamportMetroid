				float4 ShadowCoord = shadowCoord;
				float4 ScreenPosNorm = float4( GetNormalizedScreenSpaceUV( input.positionCS ), input.positionCS.zw );
				float4 ClipPos = ComputeClipSpacePosition( ScreenPosNorm.xy, input.positionCS.z ) * input.positionCS.w;
				float4 ScreenPos = ComputeScreenPos( ClipPos );
				float3 TangentWS = input.tangentWS.xyz * renormFactor;
				float3 BitangentWS = cross( input.normalWS, input.tangentWS.xyz ) * input.tangentWS.w * renormFactor;
				float3 NormalWS = input.normalWS * renormFactor;

				float ase_depthLinearEye = LinearEyeDepth( ScreenPos.z / ScreenPos.w, _ZBufferParams );
				float depthLinearEye211 = LinearEyeDepth( SHADERGRAPH_SAMPLE_SCENE_DEPTH( ScreenPosNorm.xy ), _ZBufferParams );
				float4 localCamDir10_g11 = CamDir10_g11();
				float dotResult4_g11 = dot( float4( ViewDirWS , 0.0 ) , localCamDir10_g11 );
				float3 temp_output_266_0 = ( ( min( ase_depthLinearEye, depthLinearEye211 ) * ( ViewDirWS / dotResult4_g11 ) ) + _WorldSpaceCameraPos );
				float temp_output_1_0_g12 = _DepthStart;
				float3 lerpResult304 = lerp( _MultiplyA , _MultiplyB , ( 1.0 - pow( ( 1.0 - saturate( ( ( distance( temp_output_266_0 , _WorldSpaceCameraPos ) - temp_output_1_0_g12 ) / ( _DepthEnd - temp_output_1_0_g12 ) ) ) ) , _DepthCurve ) ));
				

				float3 Color = lerpResult304;
				float Alpha = 1;
				#if defined( _ALPHATEST_ON )
